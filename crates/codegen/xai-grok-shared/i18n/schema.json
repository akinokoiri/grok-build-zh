{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grok Build zh-CN translation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "locale", "translations"],
  "properties": {
    "version": { "const": 1 },
    "locale": { "const": "zh-CN" },
    "translations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
